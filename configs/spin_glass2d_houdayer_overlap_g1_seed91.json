{
  "schema_version": 5,
  "data": {
    "cache": "../data_cache/spin_glass2d_houdayer_overlap/ensembles.pt",
    "physical_model": "2D zero-field Edwards-Anderson bimodal bonds; pair 0/1 overlap from four jointly Houdayer-updated real replicas",
    "coupling_names": [],
    "spin_flip_symmetric": true,
    "spin_flip_augment": false,
    "train_pool_replicas": 1,
    "test_pool_replicas": 1
  },
  "model": {
    "dimension": 2, "theory_dim": 1, "hidden": 96, "width": 3,
    "block_factor": 3, "kernel_layout": "nonoverlapping", "fixed_kernel": false,
    "binary_lookup": true, "kernel_initialization": "random",
    "kernel_sampling": "bernoulli", "affine_reconstruction": true,
    "reconstruction_hidden": 0, "theory_head": "nonlinear"
  },
  "loss": {
    "weights": {"anchor": 2, "coarse_consistency": 5, "separation": 10,
      "commutator": 5, "kernel_noncollapse": 2},
    "rollout_weight": 5, "closure_scale_weights": null,
    "kernel_noncollapse_mode": "variance_floor_ensemble",
    "kernel_variance_ratio": 1, "kernel_sign_weight": 1,
    "closure_metric": "euclidean", "coordinate_reduction": "sum"
  },
  "training": {
    "max_rg_steps": 2, "epochs": 6000, "system_batch": 16, "sample_batch": 64,
    "learning_rate": 0.001, "seed": 91, "threads": 1,
    "train_modules": ["Q", "C", "R"], "gradient_mode": "qc_r_separate",
    "checkpoint_every": 1000, "log_every": 200, "lr_schedule": "constant"
  },
  "evaluation": {"max_rg_steps": 2, "samples": 64, "systems": 60}
}
