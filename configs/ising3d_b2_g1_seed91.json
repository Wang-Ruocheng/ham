  "training": {
    "max_rg_steps": 2,
    "epochs": 6000,
    "system_batch": 16,
    "sample_batch": 64,
    "learning_rate": 0.001,
    "seed": 91,
    "threads": 1,
    "train_modules": ["Q", "C", "R"],
    "checkpoint_every": 1000,
    "log_every": 200,
    "gradient_mode": "qc_r_separate",
