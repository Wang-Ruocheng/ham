{
  "schema_version": 5,
  "data": {
    "cache": "../results/ising3d_b2_g1_seed91/data/ensembles.pt",
    "physical_model": "零场简单立方最近邻铁磁 Ising；K 仅生成与评价，训练缓存不含耦合标签",
    "coupling_names": [],
